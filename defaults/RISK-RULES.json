{
    "schema": "socratex-risk-rules/v1",
    "note": "Neutral default rules read by modules/tools/scripts/risk_score.py. Layers on top: profile files (config key `profiles`, modules/profiles/<name>/RISK-RULES.json), then files in config key `risk_rules`. Without those keys a project may still replace the whole file with .ai/RISK-RULES.json. Points are starting values; change them only through routing_stats proposals approved by the owner. Design: docs/ROUTER-LOOP.md.",
    "levels": {
        "light_max": 2,
        "standard_max": 5,
        "score_cap": 10
    },
    "ignore_globs": [
        "*/cache/*",
        "*.dll",
        "*.pdb",
        "*.sqlite",
        "*.lock",
        "package-lock.json"
    ],
    "path_rules": [
        {
            "name": "persistent data",
            "points": 4,
            "globs": [
                "*Persistence*",
                "*Migration*",
                "*/migrations/*",
                "*.sql"
            ]
        },
        {
            "name": "auth and payments",
            "points": 4,
            "globs": [
                "*/auth/*",
                "*Auth*",
                "*/payments/*",
                "*Payment*",
                "*Billing*"
            ]
        },
        {
            "name": "agent safety and settings",
            "points": 4,
            "globs": [
                ".claude/settings*.json",
                ".claude/hooks/*",
                ".codex/*",
                ".ai/guard.json",
                "*guard*.py",
                "*stop_gate*"
            ]
        },
        {
            "name": "build and project config",
            "points": 4,
            "globs": [
                "*.csproj",
                "*.props",
                "*.targets",
                "*.sln",
                "package.json",
                "pyproject.toml",
                "requirements*.txt",
                "Dockerfile",
                "*.gradle",
                ".github/workflows/*"
            ]
        }
    ],
    "size": {
        "lines": 150,
        "files": 5,
        "points": 2
    },
    "missing_tests": {
        "points": 2,
        "code_suffixes": [
            ".cs",
            ".py",
            ".ts",
            ".tsx",
            ".js",
            ".go",
            ".java",
            ".kt",
            ".rs",
            ".php",
            ".rb"
        ],
        "test_markers": [
            "/tests/",
            "/Tests/",
            "tests/",
            "test_",
            "Tests.",
            ".test.",
            ".spec.",
            "_test."
        ]
    },
    "writer": {
        "cheap_tier_points": 1,
        "retry_points": 1
    },
    "docs_only": {
        "points": -3,
        "suffixes": [
            ".md",
            ".txt"
        ]
    },
    "learned": []
}
