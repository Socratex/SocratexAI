{
  "schema": "socratex-module/v1",
  "name": "memory",
  "kind": "memory",
  "what": "Learning memory: skill learnings log and the ledger of named AI improvements with machine checks",
  "when": "When the owner corrects a skill, and when checking which ledger improvements fail on this machine",
  "entry": [
    "python modules/tools/scripts/skill_learn.py add --skill <skill> --kind correction --note \"<note>\"",
    "python modules/tools/scripts/skill_learn.py status",
    "python modules/tools/scripts/improvements_check.py"
  ],
  "paths": ["modules/tools/scripts/skill_learn.py", "modules/tools/scripts/improvements_check.py", "docs/IMPROVEMENTS.json"],
  "tests": ["modules/tools/scripts/tests/test_skill_learn.py", "modules/tools/scripts/tests/test_improvements_check.py"]
}
