{
  "schema": "socratex-module/v1",
  "name": "scripts",
  "kind": "tools",
  "what": "Maintenance scripts: install, backup, update, leak check, index, state helper, reference packs",
  "when": "Installing or updating the core, before changing agent config (backup), before a push (leaks), after editing docs or manifests (index)",
  "entry": [
    "python tools/install.py --check",
    "python tools/backup.py",
    "python tools/update.py all",
    "python tools/check_leaks.py",
    "python tools/build_index.py --check",
    "python tools/json_read.py <file> [<path>]",
    "python tools/subrepos.py list"
  ],
  "paths": [
    "tools/install.py",
    "tools/generated.py",
    "tools/backup.py",
    "tools/update.py",
    "tools/check_leaks.py",
    "tools/build_index.py",
    "tools/json_read.py",
    "tools/subrepos.py",
    "tools/state.py"
  ],
  "tests": [
    "tools/tests/test_install_prefs.py",
    "tools/tests/test_install_tools.py",
    "tools/tests/test_state.py",
    "tools/tests/test_subrepos.py"
  ]
}
