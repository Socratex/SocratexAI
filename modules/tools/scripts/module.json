{
  "schema": "socratex-module/v1",
  "name": "scripts",
  "kind": "tools",
  "what": "Maintenance scripts: install, backup, update, leak check, index, state helper, reference packs; tools/ holds redirect shims for external callers",
  "when": "Installing or updating the core, before changing agent config (backup), before a push (leaks), after editing docs or manifests (index)",
  "entry": [
    "python modules/tools/scripts/install.py --check",
    "python modules/tools/scripts/backup.py",
    "python modules/tools/scripts/update.py all",
    "python modules/tools/scripts/check_leaks.py",
    "python modules/tools/scripts/build_index.py --check",
    "python modules/tools/scripts/json_read.py <file> [<path>]",
    "python modules/tools/scripts/env_safe.py <env file> [--keys-only | --compare <other>]",
    "python modules/tools/scripts/subrepos.py list",
    "python core/sox shims",
    "python core/sox ledger find \"<problem in 2-5 words>\" [--project <repo>]"
  ],
  "paths": [
    "modules/tools/scripts/install.py",
    "modules/tools/scripts/generated.py",
    "modules/tools/scripts/backup.py",
    "modules/tools/scripts/update.py",
    "modules/tools/scripts/check_leaks.py",
    "modules/tools/scripts/build_index.py",
    "modules/tools/scripts/json_read.py",
    "modules/tools/scripts/env_safe.py",
    "modules/tools/scripts/subrepos.py",
    "modules/tools/scripts/state.py",
    "modules/tools/scripts/ledger_find.py",
    "core/shims.py",
    "tools"
  ],
  "tests": [
    "modules/tools/scripts/tests",
    "tests/test_shims.py"
  ]
}
