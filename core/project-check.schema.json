{
  "purpose": "Schema of core/project-check.json: the rules `sox project check` applies to a project",
  "type": "object",
  "required": ["schema", "exclude", "max_file_bytes", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "enum": ["socratex-project-check/v1"]},
    "note": {"type": "string"},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "max_file_bytes": {"type": "integer"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "what", "fix"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning"]},
          "what": {"type": "string"},
          "fix": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}},
          "patterns": {"type": "array", "items": {"type": "string"}},
          "ignore_case": {"type": "boolean"},
          "limits": {"type": "object", "additionalProperties": {"type": "integer"}},
          "known_keys": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        }
      }
    }
  }
}
