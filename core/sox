DIM = "\033[2m"
RESET = "\033[0m"


def _fmt(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def print_relaxed_safety(safety: dict) -> None:
    """The first block of `config show`: relaxed safety rules with their source, then error lines about ignored relaxations."""
    print("Relaxed safety rules:")
    for item in safety["relaxed"]:
        print(f"  {item['rule']}  <- {item['layer']}: {item['file']}")
    if not safety["relaxed"]:
        print("  none")
    for line in safety["errors"]:
        print(f"  error: {line}")
    print()


def print_enabled_extensions(enabled: list[dict]) -> None:
    """The second block of `config show`: enabled extensions with the layer that switched each one on."""
    print("Enabled extensions:")
    for item in enabled:
        print(f"  {item['name']}  <- {item['layer']}: {item['file']}")
    if not enabled:
        print("  none")
    print()


def print_stage_registries(stages: dict) -> None:
    """The third block of `config show`: checkers a layer above a stage's own checkers.json changed or added."""
    print("Stage registries:")
    for stage, info in stages.items():
        print(f"  {stage}:")
        if info["error"]:
            print(f"    error: {info['error']}")
        for change in info["changes"]:
            what = "added" if change["kind"] == "added" else f"{change['kind']} ({change['field']}: {_fmt(change['from'])} -> {_fmt(change['to'])})"
            print(f"    {change['checker']}  {what}  <- {change['layer']}: {change['file']}")
        if not info["changes"] and not info["error"]:
            print("    no changes above the stage's own checkers.json")
    if not stages:
        print("  none")
    print()


def cmd_config_show(args: argparse.Namespace) -> int:
    result = core.resolve(args.project)
    enabled = core.enabled_extensions(result)
    stages = core.stage_provenance(args.project)
    if args.json:
        print(json.dumps({**result, "enabled_extensions": enabled, "stage_registries": stages}, indent=2, ensure_ascii=False))
        return 0
    print_relaxed_safety(result["safety"])
    print_enabled_extensions(enabled)
    print_stage_registries(stages)
    rows = []
    for key in sorted(result["provenance"]):
        entry = result["provenance"][key]
        over = "; ".join(f"{_fmt(o['value'])} ({o['layer']})" for o in entry["overridden"])
        rows.append((key, _fmt(entry["value"]), f"{entry['layer']}: {entry['file']}", over))
    heads = ("key", "value", "source")
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(heads)]
    color = sys.stdout.isatty()
    print("  ".join(h.ljust(w) for h, w in zip(heads, widths)) + "  overridden")
    for key, value, source, over in rows:
        tail = (f"{DIM}{over}{RESET}" if color else over) if over else ""
        print("  ".join(c.ljust(w) for c, w in zip((key, value, source), widths)) + "  " + tail)
    return 0


def cmd_config_resolve(args: argparse.Namespace) -> int:
    core.write_effective(args.project)  # also rotates old state logs, at most once per day
    print(f"Wrote {core.effective_path()}")
    return 0


def _parse_facts(pairs: list[str]) -> dict:
    """Turn `key=value` arguments into a facts dict: true/false/ints are typed, `a,b` becomes a list."""
    facts: dict = {}
    for pair in pairs:
        key, sep, raw = pair.partition("=")
        if not sep:
            raise core.ConfigError(f"fact '{pair}' must look like key=value")
        if raw in ("true", "false"):
            facts[key] = raw == "true"
        elif raw.lstrip("-").isdigit():
            facts[key] = int(raw)
        else:
            facts[key] = raw.split(",") if "," in raw else raw
    return facts


def cmd_flow_show(args: argparse.Namespace) -> int:
    flow = core.load_flow(args.project)
    schema = core._flow_schema()
    known = _parse_facts(args.match or [])
    steps = [s for s in flow["steps"] if not args.match or core.matches(s["when"], known, schema)]
    if args.json:
        print(json.dumps({"steps": steps, "origin": flow["origin"]}, indent=2, ensure_ascii=False))
        return 0
    for number, step in enumerate(steps, 1):
        layer = flow["origin"][step["id"]]["layer"]
        print(f"{number:>2}. {step['id']}" + (f"  ({layer})" if layer != "core" else ""))
        print(f"    when: {_fmt(step['when']) if step['when'] else 'always'}")
        print(f"    then: {', '.join(step['then'])}")
        print(f"    why:  {step['why']}")
    return 0


def cmd_flow_check(args: argparse.Namespace) -> int:
    errors = core.check_flow(args.project)
    for line in errors:
        print(line, file=sys.stderr)
    if not errors:
        print("Flow is valid.")
    return 1 if errors else 0


def command_help(parser: argparse.ArgumentParser) -> list[tuple[str, str]]:
    """[(`sox <command> [<action>]`, help)] from the parser: the one list of commands (used by docs/FLOW.md)."""
    def choices(p: argparse.ArgumentParser) -> list[tuple[str, str, argparse.ArgumentParser]]:
        for action in p._actions:  # noqa: SLF001 - argparse has no public listing of subparsers
            if isinstance(action, argparse._SubParsersAction):  # noqa: SLF001
                helps = {a.dest: a.help or "" for a in action._choices_actions}  # noqa: SLF001
                return [(name, helps.get(name, ""), sub) for name, sub in action.choices.items()]
        return []

    rows = []
    for name, text, sub in choices(parser):
        nested = choices(sub)
        if nested:
            rows += [(f"sox {name} {action}", help_text) for action, help_text, _ in nested]
        else:
            rows.append((f"sox {name}", text))
    return rows


def cmd_flow_doc(args: argparse.Namespace) -> int:
    """`sox flow doc [--check]`: write docs/FLOW.md from defaults/flow.json, the parser help and the directory map."""
    commands = command_help(build_parser())
    if args.check:
        if flowdoc.is_current(commands):
            print("docs/FLOW.md is up to date.")
            return 0
        print("docs/FLOW.md is stale: run `sox flow doc`.", file=sys.stderr)
        return 1
    print(f"Wrote {flowdoc.write(commands)}")
    return 0


def cmd_shims(args: argparse.Namespace) -> int:
    """`sox shims [--list | --usage | --regenerate]`: the redirect shims at tools/ and how often they were called."""
    if args.regenerate:
        changed = shims.regenerate()
        print(f"Rewrote {len(changed)} shim(s).")
        return 0
    both = not args.list and not args.usage
    print("\n".join(shims.lines(show_list=args.list or both, show_usage=args.usage or both)))
    return 0


def cmd_install(args: argparse.Namespace) -> int:
    """Generate targets/ and plan, check or apply the install into the agent config folders."""
    import difflib

    import install
    import targets

    sys.stdout.reconfigure(encoding="utf-8")
    state.rotate_daily()
    install.apply_prefs(install.load_prefs() or {})
    if args.plan:
        report, changes = install.collect_plan(args.target)
        creates = [str(path) for path, old, _ in changes if old is None]
        changed = [str(path) for path, old, _ in changes if old is not None]
        print("Plan (dry run, nothing in the agent config folders was written; targets/ was regenerated):")
        print(f"  create: {', '.join(creates) or 'none'}")
        print(f"  change: {', '.join(changed) or 'none'}")
        print("  remove: none (the installer never deletes files; a real folder in the way of a link is moved aside)")
        for line in report:
            if not line.startswith("write "):
                print(f"  {line}")
        for path, old, new in changes:
            print()
            print("\n".join(difflib.unified_diff((old or "").splitlines(), new.splitlines(), lineterm="",
                                                  fromfile=f"{path} (installed)" if old is not None else "/dev/null",
                                                  tofile=f"{path} (generated)")))
        return 0
    if args.check:
        problems = targets.check(args.target)
        for line in problems:
            print(line, file=sys.stderr)
        if not problems:
            print("targets/ is up to date and untouched.")
        return 1 if problems else 0
    if not args.yes:
        print("error: `sox install` changes your agent config (CLAUDE.md, settings.json, links); "
              "run `sox install --plan` first, then `sox install --yes` (it makes a backup first).", file=sys.stderr)
        return 2
    return install.run("full", auto=True)


def cmd_index(args: argparse.Namespace) -> int:
    state.rotate_daily()
    return build_index.run_index(args.check)


def _human_size(count: int) -> str:
    return f"{count / 1024:.1f} KB" if count < 1024 * 1024 else f"{count / 1024 / 1024:.1f} MB"


def cmd_state(args: argparse.Namespace) -> int:
    """`sox state rotate [--dry-run]` and `sox state adopt-logs [--yes]` (see modules/tools/scripts/state.py)."""
    root = Path(args.root) if args.root else None
    if args.action == "rotate":
        removed = state.rotate_known(root, dry_run=args.dry_run)
        verb = "would remove" if args.dry_run else "removed"
        for name, paths in removed.items():
            print(f"{name}: {verb} {len(paths)} file(s)")
        if not removed:
            print("nothing to rotate (no known state subdirectory exists)")
        return 0
    found = state.adopt_logs(root, move=args.yes)
    total = sum(size for _, _, size in found)
    if not found:
        print("no legacy local/flow-debug-*.log files to adopt")
    elif args.yes:
        print(f"moved {len(found)} file(s), {_human_size(total)}, into state/flow-debug/ (nothing deleted)")
    else:
        print(f"dry run: {len(found)} legacy log(s), {_human_size(total)}, would be moved from local/ into state/flow-debug/; "
              "run with --yes to move them (nothing is ever deleted)")
    return 0


def cmd_backup(args: argparse.Namespace) -> int:
    """`sox backup [--list | --restore ZIP]`: delegates to modules/tools/scripts/backup.py (no logic copy)."""
    import backup

    argv = ["--list"] if args.list else ["--restore", args.restore] if args.restore else []
    return backup.main(argv)


def pytest_command(paths: list[str], which=None) -> list[str]:
    """The pytest command this repo's suite uses: through `uv run --with pytest --with jsonschema` when uv exists."""
    import shutil

    found = (which or shutil.which)("uv")
    pytest_args = ["-m", "pytest", "-q", *(paths or ["tests", "modules"])]
    if found:
        return [found, "run", "--with", "pytest", "--with", "jsonschema", "python", *pytest_args]
    return [sys.executable, *pytest_args]


def cmd_test(args: argparse.Namespace) -> int:
    import subprocess

    command = pytest_command(args.paths)
    print("running: " + " ".join(command), flush=True)
    return subprocess.run(command, cwd=Path(__file__).resolve().parents[1]).returncode


def cmd_migrate(args: argparse.Namespace) -> int:
    import migrate

    rows = migrate.scan(args.project)
    if not rows:
        print("Nothing to migrate: every config file is at schema_version "
              f"{core.SUPPORTED_VERSION} (registered migrations: {len(migrate.MIGRATIONS)}).")
        return 0
    for row in rows:
        print(migrate.describe(row))
    if args.check:
        return 1  # something is outdated, newer or unreadable
    for line in migrate.apply(rows):
        print(line)
    return 0 if all(r["status"] == "outdated" for r in rows) else 1


def cmd_modules(args: argparse.Namespace) -> int:
    try:
        modules = build_index.load_modules()
    except build_index.ManifestError as exc:
        print(f"error: module manifests are invalid:\n{exc}", file=sys.stderr)
        return 2
    for kind in sorted({m["kind"] for m in modules}):
        print(kind)
        for m in sorted((m for m in modules if m["kind"] == kind), key=lambda m: m["name"]):
            print(f"  {m['name']}: {m['what']}")
            print(f"    when: {m['when']}")
            for command in m["entry"]:
                print(f"    run:  {command}")
    return 0


def cmd_ext(args: argparse.Namespace) -> int:
    """`sox ext`: list, show, add, enable, disable, remove and install extensions (see core/extensions.py)."""
    import extensions

    root = args.root
    action = args.action
    if action == "list":
        lines = extensions.list_lines(root, args.project, args.category, args.status)
    elif action == "show":
        lines = extensions.show_lines(args.name, root, args.project)
    elif action == "add":
        path, ledger_id = extensions.add_extension(args.url, root, args.name, args.kind, args.category)
        lines = [f"Created {path} (status trial, off) and ledger entry {ledger_id} in docs/IMPROVEMENTS.json.",
                 "Fields marked 'unknown' and the TODO lines in the ledger entry are yours to fill in."]
    elif action in ("enable", "disable"):
        lines = [extensions.set_enabled(args.name, action == "enable", root, args.project)]
    elif action == "remove":
        touched = extensions.remove_extension(args.name, root)
        lines = [f"Removed local manifest '{args.name}'."] + [f"Dropped it from {path}" for path in touched]
        lines.append("Its ledger entry stays: the ledger is history.")
    else:
        lines = extensions.install_extension(args.name, args.yes, root)
    print("\n".join(lines))
    return 0


def _root(args: argparse.Namespace) -> Path | None:
    return Path(args.root) if getattr(args, "root", None) else None


def cmd_context(args: argparse.Namespace) -> int:
    """`sox context [--project P] [--json]`: the ordered read list (general to most important), see core/knowledge.py."""
    result = knowledge.build_context(args.project, _root(args))
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("\n".join(knowledge.format_context(result)))
        print("Read top to bottom; a later row wins on conflict; a row marked (missing) is skipped.")
    for line in result["errors"]:
        print(f"error: {line}", file=sys.stderr)
    return 1 if result["errors"] else 0


def _print_knowledge_findings(findings: list[dict]) -> None:
    for item in findings:
        mark = "(warning) " if item["severity"] == "warning" else ""
        print(f"{item['code']} {item['file']} {mark}{item['message']}")


def _project_check(args: argparse.Namespace) -> int:
    root = _root(args)
    if args.path:
        findings = project_check.run_check(args.path, root)
        try:
            key = knowledge.resolve_key(args.path, root)
        except core.ConfigError as exc:
            key = None
            extra = [{"code": "K-COLLISION", "severity": "error", "file": args.path, "message": str(exc)}]
        else:
            has = key and (knowledge.projects_dir(root) / key / "project.json").is_file()
            extra = knowledge.check_knowledge(root, key) if has else []
    else:
        findings, extra = [], knowledge.check_knowledge(root)
    code = project_check.exit_code(findings, args.strict)
    if any(f["severity"] == "error" or args.strict for f in extra):
        code = 1
    totals = project_check.counts(findings)
    for severity in ("error", "warning"):
        totals[severity] += sum(1 for f in extra if f["severity"] == severity)
    if args.json:
        payload = {"project": str(Path(args.path).resolve()) if args.path else None, "findings": findings, "counts": totals,
                   "strict": args.strict, "exit": code}
        if extra or not args.path:
            payload["knowledge"] = extra
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return code
    for finding in findings:
        print(project_check.format_line(finding))
    _print_knowledge_findings(extra)
    print(f"{totals['error']} error(s), {totals['warning']} warning(s)" + (" (strict: warnings fail)" if args.strict else ""))
    return code


def _project_list(args: argparse.Namespace) -> int:
    rows = knowledge.list_rows(_root(args))
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return 0
    heads = ("project", "group", "mode", "overrides", "summary")
    cells = [(r["project"], r["group"] or "-", r["mode"] or "?", ", ".join(r["overrides"]) or "-",
              r["summary"] or ("(invalid project.json)" if r["error"] else "-")) for r in rows]
    widths = [max([len(h)] + [len(c[i]) for c in cells]) for i, h in enumerate(heads)]
    print("  ".join(h.ljust(w) for h, w in zip(heads, widths)))
    for cell in cells:
        print("  ".join(c.ljust(w) for c, w in zip(cell, widths)))
    if not rows:
        print("no projects yet (`sox project init <repo folder>` creates one)")
    return 0


def _project_adopt(args: argparse.Namespace) -> int:
    root = _root(args)
    source = Path(args.source)
    if not source.is_dir():
        raise core.ConfigError(f"{args.source}: not a directory")
    key = knowledge.resolve_key(args.project, root)
    rows = knowledge.adopt_plan(source.resolve(), key, root, args.include or [], args.exclude or [])
    for row in rows:
        print(f"{row['action']:<8} {row['sha']}  {row['src']} -> {row['dst']}")
    counts = {a: sum(1 for r in rows if r["action"] == a) for a in ("copy", "same", "conflict")}
    print(f"{counts['copy']} to copy, {counts['same']} already identical, {counts['conflict']} conflict (kept, never overwritten); nothing is deleted.")
    if not args.yes:
        print("Plan only: nothing was written; add --yes to copy.")
        return 0
    print(f"Copied {knowledge.adopt_apply(rows)} file(s) into {knowledge.projects_dir(root) / key}.")
    return 0


def cmd_project(args: argparse.Namespace) -> int:
    """`sox project check|init|list|show|adopt|explain`: audit, onboard and browse projects (core/project_check.py, core/knowledge.py)."""
    root = _root(args)
    if args.action == "explain":
        print("\n".join(project_check.explain(args.rule)))
        return 0
    if args.action == "list":
        return _project_list(args)
    if args.action == "show":
        print("\n".join(knowledge.show_lines(args.project, root)))
        return 0
    if args.action == "adopt":
        return _project_adopt(args)
    if args.action == "init":
        repo = project_check.require_project(args.path)
        print("\n".join(project_check.init_project(args.path, args.write, root)))
        if not args.no_knowledge:
            print("\n".join(knowledge.init_knowledge(repo, args.write, root, args.name, args.group, args.prefix, args.summary)))
        if not args.write:
            print("Dry run: nothing was written; add --write to create the missing files.")
        return 0
    return _project_check(args)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sox", description=__doc__)
    top = parser.add_subparsers(dest="command", required=True)
    config = top.add_parser("config", help="inspect the layered config")
    sub = config.add_subparsers(dest="action", required=True)
    show = sub.add_parser("show", help="print resolved values with their source")
    show.add_argument("--project", help="project root (adds the project and project-private layers)")
    show.add_argument("--json", action="store_true")
    resolve = sub.add_parser("resolve", help="write state/effective.json")
    resolve.add_argument("--project")
    flow = top.add_parser("flow", help="inspect and check the flow table (defaults/flow.json plus overrides)")
    flow_sub = flow.add_subparsers(dest="action", required=True)
    flow_show = flow_sub.add_parser("show", help="print the steps in order")
    flow_show.add_argument("--project", help="project root (adds the project and project-private overrides)")
    flow_show.add_argument("--match", nargs="+", metavar="FACT=VALUE", help="print only steps whose condition holds for these facts, e.g. task_size=big touches=auth,data")
    flow_show.add_argument("--json", action="store_true")
    flow_check = flow_sub.add_parser("check", help="exit 1 when a step points to a missing stage, role, rule or tool, or the grammar is broken")
    flow_check.add_argument("--project")
    flow_doc = flow_sub.add_parser("doc", help="write docs/FLOW.md (what to run when) from the flow table, commands and directory map")
    flow_doc.add_argument("--check", action="store_true", help="exit 1 when docs/FLOW.md is stale")
    index = top.add_parser("index", help="regenerate INDEX.json from files and module manifests")
    index.add_argument("--check", action="store_true", help="exit 1 when INDEX.json is stale")
    install = top.add_parser("install", help="generate targets/ and plan, check or apply the agent config install")
    mode = install.add_mutually_exclusive_group()
    mode.add_argument("--plan", action="store_true", help="dry run: diff generated files against the installed ones")
    mode.add_argument("--check", action="store_true", help="exit 1 when targets/ is missing, stale or hand-edited")
    mode.add_argument("--yes", action="store_true", help="apply: back up the agent config, then install")
    install.add_argument("--target", choices=("claude", "codex"), help="limit --plan and --check to one agent")
    state_cmd = top.add_parser("state", help="machine output in state/: rotate old logs, adopt legacy logs from local/")
    state_cmd.add_argument("--root", help=argparse.SUPPRESS)
    state_sub = state_cmd.add_subparsers(dest="action", required=True)
    state_rotate = state_sub.add_parser("rotate", help="delete old and surplus files in the known state subdirectories (modules/tools/scripts/state.py)")
    state_rotate.add_argument("--dry-run", action="store_true", help="only count what would be removed")
    state_adopt = state_sub.add_parser("adopt-logs", help="move legacy local/flow-debug-*.log into state/flow-debug/ (never deletes)")
    state_adopt.add_argument("--yes", action="store_true", help="really move; without it only the count and size are printed")
    backup_cmd = top.add_parser("backup", help="zip the agent config (modules/tools/scripts/backup.py); list or restore backups")
    backup_mode = backup_cmd.add_mutually_exclusive_group()
    backup_mode.add_argument("--list", action="store_true", help="list existing backups")
    backup_mode.add_argument("--restore", metavar="ZIP", help="put a backup back in place (backs up the current state first)")
    test_cmd = top.add_parser("test", help="run this repo's test suite the way it is normally run")
    test_cmd.add_argument("paths", nargs="*", help="default: tests modules")
    migrate_cmd = top.add_parser("migrate", help="upgrade config files whose schema_version is older than supported")
    migrate_cmd.add_argument("--check", action="store_true", help="only list outdated files and the migrations that would run; exit 1 if any")
    migrate_cmd.add_argument("--project", help="project root (adds the project and project-private layers)")
    shims_cmd = top.add_parser("shims", help="list the tools/ redirect shims and how often external callers used them")
    shims_mode = shims_cmd.add_mutually_exclusive_group()
    shims_mode.add_argument("--list", action="store_true", help="only the shim to script mapping")
    shims_mode.add_argument("--usage", action="store_true", help="only the call counts (state/shim-usage.jsonl)")
    shims_mode.add_argument("--regenerate", action="store_true", help="rewrite the shims from the template")
    top.add_parser("modules", help="list modules by kind: what, when to run, entry commands")
    ext = top.add_parser("ext", help="extension registry: plugins, mods, skills, reference packs")
    ext.add_argument("--root", help=argparse.SUPPRESS)
    ext_sub = ext.add_subparsers(dest="action", required=True)
    ext_list = ext_sub.add_parser("list", help="extensions grouped by category with status, kind and on/off for the project")
    ext_list.add_argument("--project", help="project root (adds the project layers to the on/off column)")
    ext_list.add_argument("--category")
    ext_list.add_argument("--status", choices=("recommended", "trial", "adopted", "rejected"))
    ext_show = ext_sub.add_parser("show", help="print one manifest")
    ext_show.add_argument("name")
    ext_show.add_argument("--project")
    ext_add = ext_sub.add_parser("add", help="create a trial manifest in local/extensions and an entry in docs/IMPROVEMENTS.json")
    ext_add.add_argument("url")
    ext_add.add_argument("--name")
