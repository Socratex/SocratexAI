#!/usr/bin/env python3
"""sox: the SocratexAI command line (config, index, modules; more subcommands register in COMMANDS)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import core  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

import build_index  # noqa: E402

DIM = "\033[2m"
RESET = "\033[0m"


def _fmt(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def cmd_config_show(args: argparse.Namespace) -> int:
    result = core.resolve(args.project)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0
    rows = []
    for key in sorted(result["provenance"]):
        entry = result["provenance"][key]
        over = "; ".join(f"{_fmt(o['value'])} ({o['layer']})" for o in entry["overridden"])
        rows.append((key, _fmt(entry["value"]), f"{entry['layer']}: {entry['file']}", over))
    heads = ("key", "value", "source")
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(heads)]
    color = sys.stdout.isatty()
    print("  ".join(h.ljust(w) for h, w in zip(heads, widths)) + "  overridden")
    for key, value, source, over in rows:
        tail = (f"{DIM}{over}{RESET}" if color else over) if over else ""
        print("  ".join(c.ljust(w) for c, w in zip((key, value, source), widths)) + "  " + tail)
    return 0


def cmd_config_resolve(args: argparse.Namespace) -> int:
    core.write_effective(args.project)
    print(f"Wrote {core.effective_path()}")
    return 0


def _parse_facts(pairs: list[str]) -> dict:
    """Turn `key=value` arguments into a facts dict: true/false/ints are typed, `a,b` becomes a list."""
    facts: dict = {}
    for pair in pairs:
        key, sep, raw = pair.partition("=")
        if not sep:
            raise core.ConfigError(f"fact '{pair}' must look like key=value")
        if raw in ("true", "false"):
            facts[key] = raw == "true"
        elif raw.lstrip("-").isdigit():
            facts[key] = int(raw)
        else:
            facts[key] = raw.split(",") if "," in raw else raw
    return facts


def cmd_flow_show(args: argparse.Namespace) -> int:
    flow = core.load_flow(args.project)
    schema = core._flow_schema()
    known = _parse_facts(args.match or [])
    steps = [s for s in flow["steps"] if not args.match or core.matches(s["when"], known, schema)]
    if args.json:
        print(json.dumps({"steps": steps, "origin": flow["origin"]}, indent=2, ensure_ascii=False))
        return 0
    for number, step in enumerate(steps, 1):
        layer = flow["origin"][step["id"]]["layer"]
        print(f"{number:>2}. {step['id']}" + (f"  ({layer})" if layer != "core" else ""))
        print(f"    when: {_fmt(step['when']) if step['when'] else 'always'}")
        print(f"    then: {', '.join(step['then'])}")
        print(f"    why:  {step['why']}")
    return 0


def cmd_flow_check(args: argparse.Namespace) -> int:
    errors = core.check_flow(args.project)
    for line in errors:
        print(line, file=sys.stderr)
    if not errors:
        print("Flow is valid.")
    return 1 if errors else 0


def cmd_index(args: argparse.Namespace) -> int:
    return build_index.run_index(args.check)


def cmd_modules(args: argparse.Namespace) -> int:
    try:
        modules = build_index.load_modules()
    except build_index.ManifestError as exc:
        print(f"error: module manifests are invalid:\n{exc}", file=sys.stderr)
        return 2
    for kind in sorted({m["kind"] for m in modules}):
        print(kind)
        for m in sorted((m for m in modules if m["kind"] == kind), key=lambda m: m["name"]):
            print(f"  {m['name']}: {m['what']}")
            print(f"    when: {m['when']}")
            for command in m["entry"]:
                print(f"    run:  {command}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sox", description=__doc__)
    top = parser.add_subparsers(dest="command", required=True)
    config = top.add_parser("config", help="inspect the layered config")
    sub = config.add_subparsers(dest="action", required=True)
    show = sub.add_parser("show", help="print resolved values with their source")
    show.add_argument("--project", help="project root (adds the project and project-private layers)")
    show.add_argument("--json", action="store_true")
    resolve = sub.add_parser("resolve", help="write state/effective.json")
    resolve.add_argument("--project")
    flow = top.add_parser("flow", help="inspect and check the flow table (core/flow.json plus overrides)")
    flow_sub = flow.add_subparsers(dest="action", required=True)
    flow_show = flow_sub.add_parser("show", help="print the steps in order")
    flow_show.add_argument("--project", help="project root (adds the project and project-private overrides)")
    flow_show.add_argument("--match", nargs="+", metavar="FACT=VALUE", help="print only steps whose condition holds for these facts, e.g. task_size=big touches=auth,data")
    flow_show.add_argument("--json", action="store_true")
    flow_check = flow_sub.add_parser("check", help="exit 1 when a step points to a missing stage, role, rule or tool, or the grammar is broken")
    flow_check.add_argument("--project")
    index = top.add_parser("index", help="regenerate INDEX.json from files and module manifests")
    index.add_argument("--check", action="store_true", help="exit 1 when INDEX.json is stale")
    top.add_parser("modules", help="list modules by kind: what, when to run, entry commands")
    parser.set_defaults(action=None)
    return parser


# (command, action) -> handler; add new subcommands here.
COMMANDS = {("config", "show"): cmd_config_show, ("config", "resolve"): cmd_config_resolve,
            ("flow", "show"): cmd_flow_show, ("flow", "check"): cmd_flow_check,
            ("index", None): cmd_index, ("modules", None): cmd_modules}


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return COMMANDS[(args.command, args.action)](args)
    except core.ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
