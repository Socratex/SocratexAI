#!/usr/bin/env python3
"""sox: the SocratexAI command line (config, index, modules; more subcommands register in COMMANDS)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import core  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

import build_index  # noqa: E402

DIM = "\033[2m"
RESET = "\033[0m"


def _fmt(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def print_relaxed_safety(safety: dict) -> None:
    """The first block of `config show`: relaxed safety rules with their source, then error lines about ignored relaxations."""
    print("Relaxed safety rules:")
    for item in safety["relaxed"]:
        print(f"  {item['rule']}  <- {item['layer']}: {item['file']}")
    if not safety["relaxed"]:
        print("  none")
    for line in safety["errors"]:
        print(f"  error: {line}")
    print()


def print_enabled_extensions(enabled: list[dict]) -> None:
    """The second block of `config show`: enabled extensions with the layer that switched each one on."""
    print("Enabled extensions:")
    for item in enabled:
        print(f"  {item['name']}  <- {item['layer']}: {item['file']}")
    if not enabled:
        print("  none")
    print()


def cmd_config_show(args: argparse.Namespace) -> int:
    result = core.resolve(args.project)
    enabled = core.enabled_extensions(result)
    if args.json:
        print(json.dumps({**result, "enabled_extensions": enabled}, indent=2, ensure_ascii=False))
        return 0
    print_relaxed_safety(result["safety"])
    print_enabled_extensions(enabled)
    rows = []
    for key in sorted(result["provenance"]):
        entry = result["provenance"][key]
        over = "; ".join(f"{_fmt(o['value'])} ({o['layer']})" for o in entry["overridden"])
        rows.append((key, _fmt(entry["value"]), f"{entry['layer']}: {entry['file']}", over))
    heads = ("key", "value", "source")
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(heads)]
    color = sys.stdout.isatty()
    print("  ".join(h.ljust(w) for h, w in zip(heads, widths)) + "  overridden")
    for key, value, source, over in rows:
        tail = (f"{DIM}{over}{RESET}" if color else over) if over else ""
        print("  ".join(c.ljust(w) for c, w in zip((key, value, source), widths)) + "  " + tail)
    return 0


def cmd_config_resolve(args: argparse.Namespace) -> int:
    core.write_effective(args.project)
    print(f"Wrote {core.effective_path()}")
    return 0


def _parse_facts(pairs: list[str]) -> dict:
    """Turn `key=value` arguments into a facts dict: true/false/ints are typed, `a,b` becomes a list."""
    facts: dict = {}
    for pair in pairs:
        key, sep, raw = pair.partition("=")
        if not sep:
            raise core.ConfigError(f"fact '{pair}' must look like key=value")
        if raw in ("true", "false"):
            facts[key] = raw == "true"
        elif raw.lstrip("-").isdigit():
            facts[key] = int(raw)
        else:
            facts[key] = raw.split(",") if "," in raw else raw
    return facts


def cmd_flow_show(args: argparse.Namespace) -> int:
    flow = core.load_flow(args.project)
    schema = core._flow_schema()
    known = _parse_facts(args.match or [])
    steps = [s for s in flow["steps"] if not args.match or core.matches(s["when"], known, schema)]
    if args.json:
        print(json.dumps({"steps": steps, "origin": flow["origin"]}, indent=2, ensure_ascii=False))
        return 0
    for number, step in enumerate(steps, 1):
        layer = flow["origin"][step["id"]]["layer"]
        print(f"{number:>2}. {step['id']}" + (f"  ({layer})" if layer != "core" else ""))
        print(f"    when: {_fmt(step['when']) if step['when'] else 'always'}")
        print(f"    then: {', '.join(step['then'])}")
        print(f"    why:  {step['why']}")
    return 0


def cmd_flow_check(args: argparse.Namespace) -> int:
    errors = core.check_flow(args.project)
    for line in errors:
        print(line, file=sys.stderr)
    if not errors:
        print("Flow is valid.")
    return 1 if errors else 0


def cmd_install(args: argparse.Namespace) -> int:
    """Generate targets/ and plan, check or apply the install into the agent config folders."""
    import difflib

    import install
    import targets

    sys.stdout.reconfigure(encoding="utf-8")
    install.apply_prefs(install.load_prefs() or {})
    if args.plan:
        report, changes = install.collect_plan(args.target)
        creates = [str(path) for path, old, _ in changes if old is None]
        changed = [str(path) for path, old, _ in changes if old is not None]
        print("Plan (dry run, nothing in the agent config folders was written; targets/ was regenerated):")
        print(f"  create: {', '.join(creates) or 'none'}")
        print(f"  change: {', '.join(changed) or 'none'}")
        print("  remove: none (the installer never deletes files; a real folder in the way of a link is moved aside)")
        for line in report:
            if not line.startswith("write "):
                print(f"  {line}")
        for path, old, new in changes:
            print()
            print("\n".join(difflib.unified_diff((old or "").splitlines(), new.splitlines(), lineterm="",
                                                  fromfile=f"{path} (installed)" if old is not None else "/dev/null",
                                                  tofile=f"{path} (generated)")))
        return 0
    if args.check:
        problems = targets.check(args.target)
        for line in problems:
            print(line, file=sys.stderr)
        if not problems:
            print("targets/ is up to date and untouched.")
        return 1 if problems else 0
    if not args.yes:
        print("error: `sox install` changes your agent config (CLAUDE.md, settings.json, links); "
              "run `sox install --plan` first, then `sox install --yes` (it makes a backup first).", file=sys.stderr)
        return 2
    return install.run("full", auto=True)


def cmd_index(args: argparse.Namespace) -> int:
    return build_index.run_index(args.check)


def cmd_modules(args: argparse.Namespace) -> int:
    try:
        modules = build_index.load_modules()
    except build_index.ManifestError as exc:
        print(f"error: module manifests are invalid:\n{exc}", file=sys.stderr)
        return 2
    for kind in sorted({m["kind"] for m in modules}):
        print(kind)
        for m in sorted((m for m in modules if m["kind"] == kind), key=lambda m: m["name"]):
            print(f"  {m['name']}: {m['what']}")
            print(f"    when: {m['when']}")
            for command in m["entry"]:
                print(f"    run:  {command}")
    return 0


def cmd_ext(args: argparse.Namespace) -> int:
    """`sox ext`: list, show, add, enable, disable, remove and install extensions (see core/extensions.py)."""
    import extensions

    root = args.root
    action = args.action
    if action == "list":
        lines = extensions.list_lines(root, args.project, args.category, args.status)
    elif action == "show":
        lines = extensions.show_lines(args.name, root, args.project)
    elif action == "add":
        path, ledger_id = extensions.add_extension(args.url, root, args.name, args.kind, args.category)
        lines = [f"Created {path} (status trial, off) and ledger entry {ledger_id} in docs/IMPROVEMENTS.json.",
                 "Fields marked 'unknown' and the TODO lines in the ledger entry are yours to fill in."]
    elif action in ("enable", "disable"):
        lines = [extensions.set_enabled(args.name, action == "enable", root, args.project)]
    elif action == "remove":
        touched = extensions.remove_extension(args.name, root)
        lines = [f"Removed local manifest '{args.name}'."] + [f"Dropped it from {path}" for path in touched]
        lines.append("Its ledger entry stays: the ledger is history.")
    else:
        lines = extensions.install_extension(args.name, args.yes, root)
    print("\n".join(lines))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sox", description=__doc__)
    top = parser.add_subparsers(dest="command", required=True)
    config = top.add_parser("config", help="inspect the layered config")
    sub = config.add_subparsers(dest="action", required=True)
    show = sub.add_parser("show", help="print resolved values with their source")
    show.add_argument("--project", help="project root (adds the project and project-private layers)")
    show.add_argument("--json", action="store_true")
    resolve = sub.add_parser("resolve", help="write state/effective.json")
    resolve.add_argument("--project")
    flow = top.add_parser("flow", help="inspect and check the flow table (core/flow.json plus overrides)")
    flow_sub = flow.add_subparsers(dest="action", required=True)
    flow_show = flow_sub.add_parser("show", help="print the steps in order")
    flow_show.add_argument("--project", help="project root (adds the project and project-private overrides)")
    flow_show.add_argument("--match", nargs="+", metavar="FACT=VALUE", help="print only steps whose condition holds for these facts, e.g. task_size=big touches=auth,data")
    flow_show.add_argument("--json", action="store_true")
    flow_check = flow_sub.add_parser("check", help="exit 1 when a step points to a missing stage, role, rule or tool, or the grammar is broken")
    flow_check.add_argument("--project")
    index = top.add_parser("index", help="regenerate INDEX.json from files and module manifests")
    index.add_argument("--check", action="store_true", help="exit 1 when INDEX.json is stale")
    install = top.add_parser("install", help="generate targets/ and plan, check or apply the agent config install")
    mode = install.add_mutually_exclusive_group()
    mode.add_argument("--plan", action="store_true", help="dry run: diff generated files against the installed ones")
    mode.add_argument("--check", action="store_true", help="exit 1 when targets/ is missing, stale or hand-edited")
    mode.add_argument("--yes", action="store_true", help="apply: back up the agent config, then install")
    install.add_argument("--target", choices=("claude", "codex"), help="limit --plan and --check to one agent")
    top.add_parser("modules", help="list modules by kind: what, when to run, entry commands")
    ext = top.add_parser("ext", help="extension registry: plugins, mods, skills, reference packs")
    ext.add_argument("--root", help=argparse.SUPPRESS)
    ext_sub = ext.add_subparsers(dest="action", required=True)
    ext_list = ext_sub.add_parser("list", help="extensions grouped by category with status, kind and on/off for the project")
    ext_list.add_argument("--project", help="project root (adds the project layers to the on/off column)")
    ext_list.add_argument("--category")
    ext_list.add_argument("--status", choices=("recommended", "trial", "adopted", "rejected"))
    ext_show = ext_sub.add_parser("show", help="print one manifest")
    ext_show.add_argument("name")
    ext_show.add_argument("--project")
    ext_add = ext_sub.add_parser("add", help="create a trial manifest in local/extensions and an entry in docs/IMPROVEMENTS.json")
    ext_add.add_argument("url")
    ext_add.add_argument("--name")
    ext_add.add_argument("--kind", choices=("ref", "install", "note"), default="note")
    ext_add.add_argument("--category")
    for verb in ("enable", "disable"):
        ext_switch = ext_sub.add_parser(verb, help=f"{verb} an extension in one config layer file")
        ext_switch.add_argument("name")
        ext_switch.add_argument("--project", help="project root: writes local/projects/<project>/config.json instead of local/overrides")
    ext_remove = ext_sub.add_parser("remove", help="delete a local manifest and drop it from the owner's config layers")
    ext_remove.add_argument("name")
    ext_install = ext_sub.add_parser("install", help="kind install only: print the commands; with --yes back up the agent config, then run them")
    ext_install.add_argument("name")
    ext_install.add_argument("--yes", action="store_true", help="the owner's explicit yes: backup first, then run the commands")
    parser.set_defaults(action=None)
    return parser


# (command, action) -> handler; add new subcommands here.
COMMANDS = {("config", "show"): cmd_config_show, ("config", "resolve"): cmd_config_resolve,
            ("flow", "show"): cmd_flow_show, ("flow", "check"): cmd_flow_check,
            ("index", None): cmd_index, ("install", None): cmd_install, ("modules", None): cmd_modules}
for _action in ("list", "show", "add", "enable", "disable", "remove", "install"):
    COMMANDS[("ext", _action)] = cmd_ext


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return COMMANDS[(args.command, args.action)](args)
    except core.ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
